# don't commit terraform
**/.terraform/
*.tfstate
*.tfstate.backup
.terraform.lock.hcl

# SSH keys — never commit private keys
*.pem
*.key

# C++ build artifacts
build/
engine/build/
cmake-build-*/
*.o
*.a
*.out
*.dSYM/

# Python
venv/
__pycache__/
*.pyc

# macOS
.DS_Store

# CLion
.idea/

# runtime output
engine/src/output
engine/debug



